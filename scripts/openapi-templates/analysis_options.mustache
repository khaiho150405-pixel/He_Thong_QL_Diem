analyzer:
  language:
    strict-inference: true
    strict-raw-types: true
    strict-casts: false
  exclude:
    - lib/src/model/*.g.dart
  errors:
    # dart-dio imports response-error models even though Dio throws them raw.
    # Limited to this generated package; handwritten Flutter retains this lint.
    unused_import: ignore
    deprecated_member_use_from_same_package: ignore
