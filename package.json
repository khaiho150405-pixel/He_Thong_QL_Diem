{
  "name": "quan-ly-diem",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "infra:up": "docker compose --env-file .env -f infrastructure/compose.yaml up -d --wait postgres redis minio && docker compose --env-file .env -f infrastructure/compose.yaml run --rm storage-init",
    "infra:down": "docker compose --env-file .env -f infrastructure/compose.yaml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:create": "prisma migrate dev --create-only",
    "db:seed": "tsx database/seeds/seed.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "api:export": "tsx apps/api/src/export-openapi.ts",
    "client:generate": "node scripts/generate-client.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps/api scripts database --no-error-on-unmatched-pattern && node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test apps/api/test/*.test.ts",
    "test:db": "tsx --test database/tests/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 apps/api/test/integration/*.test.ts",
    "build": "pnpm --filter @qld/api build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "eslint": "10.10.0",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "dependencies": {
    "argon2": "0.44.0",
    "dotenv": "17.2.3",
    "pg": "8.16.3"
  }
}
