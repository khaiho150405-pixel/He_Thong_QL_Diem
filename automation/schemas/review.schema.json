              "NEW",
              "STILL_OPEN",
              "RESOLVED"
            ]
          },
          "location": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "fix_hint": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalate": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "implementer_position",
          "reviewer_position"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "implementer_position": {
            "type": "string"
          },
          "reviewer_position": {
            "type": "string"
          }
        }
      }
