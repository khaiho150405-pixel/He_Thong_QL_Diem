{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "round",
    "verdict",
    "summary",
    "criteria",
    "findings",
    "suggestions",
    "escalate"
  ],
  "properties": {
    "phase": {
      "type": "string"
    },
    "round": {
      "type": "integer"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "summary": {
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "how"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_VERIFIED"
            ]
          },
          "how": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "criterion",
          "status",
          "location",
          "evidence",
          "fix_hint",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR"
