APP_ENV=development
API_PORT=3000
ALLOWED_ORIGINS=http://localhost:8080
POSTGRES_PORT=5433
POSTGRES_DB=quan_ly_diem_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_LOCALLY
MIGRATION_PASSWORD=REPLACE_LOCALLY
RUNTIME_PASSWORD=REPLACE_LOCALLY
DATABASE_URL=postgresql://app_runtime:REPLACE_LOCALLY@localhost:5433/quan_ly_diem_dev
MIGRATION_DATABASE_URL=postgresql://app_migration:REPLACE_LOCALLY@localhost:5433/quan_ly_diem_dev
REDIS_URL=redis://localhost:6379
MINIO_ROOT_USER=local_admin
MINIO_ROOT_PASSWORD=REPLACE_LOCALLY
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=REPLACE_LOCALLY
S3_SECRET_KEY=REPLACE_LOCALLY
S3_BUCKET=gradebook-images
RECOGNITION_SERVICE_URL=http://localhost:8000
RECOGNITION_MODEL_MODE=fake
# τ riêng từng kênh của luật hợp nhất (nghiên cứu; khóa ở BE-22): kênh đủ tin cậy khi độ tin cậy ≥ τ.
RECOGNITION_NUMERIC_THRESHOLD=0.95
RECOGNITION_WRITTEN_THRESHOLD=0.90
# Ràng buộc STT + họ tên (BE-24b/24c), mặc định BẬT: dịch vụ nhận dạng đọc ô STT in bằng VietOCR gốc; Xanh chỉ khi tên khớp mạnh VÀ STT
# khớp mô hình STT của TRANG (quy ước sắp xếp A/B, độ lệch cố định k do học sinh đã nghỉ, có cộng dòng gạch hay không; chọn theo các
# dòng tên mạnh của chính trang, cần >= 3 dòng ủng hộ). STT không quyết định gán học sinh, trừ trong nhóm trùng họ tên.
# 0 = tắt (chỉ cần tên khớp). Đặt cùng giá trị cho dịch vụ nhận dạng và worker.
RECOGNITION_STT_CHECK=1
# Mức sàn của nhánh đồng thuận (hai kênh cùng giá trị → Xanh). 0 = đúng luật nghiên cứu; dưới sàn thì hạ xuống Vàng.
RECOGNITION_NUMERIC_FLOOR=0.00
RECOGNITION_WRITTEN_FLOOR=0.00
# Chế độ weights (production): đường dẫn trọng số + SHA-256 kỳ vọng; thiếu/sai → MODEL_UNAVAILABLE.
# Không tải gì từ Internet lúc chạy; chỉ nạp bằng chế độ an toàn của torch (weights_only).
# RECOGNITION_CRNN_WEIGHTS=/models/crnn_num_best_dot5.pth
# RECOGNITION_CRNN_SHA256=<64 ký tự hex>
# RECOGNITION_VIETOCR_WEIGHTS=/models/vietocr_best_tang4.pth
# RECOGNITION_VIETOCR_SHA256=<64 ký tự hex>
# Cột Họ tên là chữ IN: dùng VietOCR GỐC tổng quát (vgg_seq2seq), KHÔNG dùng bản tinh chỉnh điểm chữ. Bắt buộc;
# thiếu thì MODEL_UNAVAILABLE (không tự dùng mô hình điểm chữ thay thế).
# RECOGNITION_NAME_WEIGHTS=/models/vietocr_vgg_seq2seq_pretrained.pth
# RECOGNITION_NAME_SHA256=<64 ký tự hex>
# RECOGNITION_DEVICE=cpu
# Thời gian chờ (ms) dịch vụ nhận dạng cho mỗi ảnh; 1000–600000, mặc định 120000.
RECOGNITION_TIMEOUT_MS=120000
UPLOAD_RATE_LIMIT_PER_MINUTE=10
SEED_PASSWORD=REPLACE_LOCALLY
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
